map $http_user_agent $block_bot {
    default 0;
    ~*(bot|crawler|spider|scrapy|curl|wget|python|httpclient) 1;
}

server {
    listen 443 ssl;
        http2 on;
    server_name grafana.nicolas-simond.ch;

    # SSL configuration...
        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

    error_log /var/log/nginx/grafana.nicolas-simond.ch/error.log;
    NaxsiLogFile /var/log/nginx/grafana.nicolas-simond.ch/naxsi_error.log;

    if ($block_bot) {
        return 403;
    }

    include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

    location = /login {
        limit_req zone=login burst=5 nodelay;

        # Naxsi WAF - core rules, standard thresholds.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;

        client_max_body_size 512M;
        proxy_pass http://192.168.1.250:3000;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        more_set_headers "X-Frame-Options SAMEORIGIN always";
    }

        location / {
        client_max_body_size 512M;

        # Naxsi WAF - core rules, standard thresholds, applied to the
        # whole app including its JSON API. No community-validated
        # Grafana whitelist exists - watch for false positives on
        # dashboard JSON payloads / alert rule expressions.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;

        proxy_pass http://192.168.1.250:3000;
        proxy_set_header Connection $http_connection;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        more_set_headers "X-Frame-Options SAMEORIGIN always";
    }
}
