server {
        listen 443 ssl;
        http2 on;

    # Update this line to be your domain
    server_name passbolt.nicolas-simond.ch;

    # Ensure these lines point to your SSL certificate and key
#    ssl_certificate /root/.acme.sh/ha-home.nicolas-simond.ch_ecc/fullchain.cer;
#    ssl_certificate_key /root/.acme.sh/ha-home.nicolas-simond.ch_ecc/ha-home.nicolas-simond.ch.key;

        ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

        error_log /var/log/nginx/passbolt.nicolas-simond.ch/error.log;
        NaxsiLogFile /var/log/nginx/passbolt.nicolas-simond.ch/naxsi_error.log;

    server_tokens off;

    client_max_body_size 200M;

    include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

    location / {
        # Naxsi WAF - core rules, standard thresholds, applied to the
        # whole app including its JSON API. No community-validated
        # Passbolt whitelist exists. Passbolt exchanges armored PGP
        # blobs (base64 + "-----BEGIN/END..." + checksum "=" lines) as
        # JSON string values - test encrypt/decrypt/share flows
        # thoroughly before trusting this in production; raise
        # thresholds or add targeted whitelists if false positives show.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        include /usr/local/etc/nginx/naxsi/passbolt_whitelist.rules;

        proxy_pass https://192.168.1.18;  # Or https://passbolt-internal:443 if backend has SSL
        proxy_ssl_verify off;
        proxy_set_header Host passbolt.nicolas-simond.ch;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket support for Passbolt
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;

        proxy_buffering off;
}
}
