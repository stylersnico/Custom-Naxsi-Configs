server {
    listen 443 ssl;
        http2 on;
    server_name umami.nicolas-simond.ch;

    # SSL configuration
    ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

    # Logging
    error_log /var/log/nginx/umami.nicolas-simond.ch/error.log;
    NaxsiLogFile /var/log/nginx/umami.nicolas-simond.ch/naxsi_error.log;
    limit_conn conn_umami 100;

    include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

    # Proxy settings
    location / {
        # Naxsi WAF - core rules, standard thresholds. No community
        # whitelist exists for Umami. Risk area: /api/send is a public,
        # unauthenticated tracking endpoint that forwards the tracked
        # page's own URL/referrer/query-string as submitted by visitors'
        # browsers - real-world URLs with odd UTM params or encoded
        # characters could trip false positives more than on an
        # authenticated app. Watch naxsi_error.log there specifically.
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;

        proxy_pass http://192.168.1.10:3421;
        proxy_http_version 1.1;

        # Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffering
        proxy_buffering off;
    }
}
