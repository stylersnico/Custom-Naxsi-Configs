server {
    listen 443 ssl;
        http2 on;
    server_name checkmk.nicolas-simond.ch;

    ssl_certificate /etc/letsencrypt/live/nicolas-simond.ch/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nicolas-simond.ch/privkey.pem;

    error_log /var/log/nginx/checkmk.nicolas-simond.ch/error.log;
    NaxsiLogFile /var/log/nginx/checkmk.nicolas-simond.ch/naxsi_error.log;
    limit_conn conn_checkmk 100;

    include /usr/local/etc/nginx/naxsi/naxsi_denied.conf;

    # Dashboard/widget subsystem: six different fields already needed
    # full wl:0 whitelisting (names, context, content, text,
    # general_settings, url) - it passes Python-repr-like serialized
    # visualization state through nearly every field. Bypass naxsi
    # entirely here rather than continuing field-by-field, same
    # treatment as Wiki.js's /graphql. Everything else (login, config
    # rule editing) stays protected via location / below.
    location ~ ^/cmk/check_mk/(widget_[a-z_]+\.py|sidebar_snapin\.py|api/internal/domain-types/dashboard/) {
        proxy_pass http://192.168.1.15:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        # Naxsi WAF - core rules, standard thresholds. No community
        # whitelist exists for CheckMK. Watch for false positives when
        # editing complex rule conditions (regex host/service patterns
        # contain heavy punctuation).
        SecRulesEnabled;
        CheckRule "$SQL >= 8" BLOCK;
        CheckRule "$RFI >= 8" BLOCK;
        CheckRule "$TRAVERSAL >= 4" BLOCK;
        CheckRule "$EVADE >= 4" BLOCK;
        CheckRule "$UPLOAD >= 8" BLOCK;
        CheckRule "$XSS >= 8" BLOCK;
        include /usr/local/etc/nginx/naxsi/checkmk_whitelist.rules;

        proxy_pass http://192.168.1.15:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_connect_timeout 60s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
