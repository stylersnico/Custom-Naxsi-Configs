# CheckMK naxsi whitelist - hand-written, NOT a community-maintained
# ruleset (none exists for CheckMK). Scoped narrowly to fix confirmed
# false positives from real traffic in naxsi_error.log; only extend
# when a new false positive is confirmed there, not speculatively.

# Login password field: a password containing a single quote (or any
# other special character) blocked login entirely (rule 1013). WAF
# character scanning on a password field is not meaningful protection
# - the backend handles it via hashing/prepared statements regardless
# of content - and only creates login lockouts for users with strong/
# varied passwords. Whitelisted entirely, same "wl:0" pattern used for
# other inherently-arbitrary fields.
BasicRule wl:0 "mz:$BODY_VAR:_password";

# CheckMK's session cookies are heavily percent-encoded, tripping the
# "double encoding" rule (1315) in the Cookie header on nearly every
# request after login (2FA page, main dashboard...). Same false
# positive already fixed for Nextcloud - reuse the same cookie-header
# whitelist rule ID list wordpress.rules uses for its own cookies.
BasicRule wl:1000,1001,1005,1007,1010,1011,1013,1100,1101,1200,1308,1309,1310,1311,1315 "mz:$HEADERS_VAR:cookie";

# CheckMK's dashboard/widget system serializes its visualization state
# (filters, layout, titles) as Python-repr-like structured data passed
# through these fields - quote/paren-heavy by nature (scores up to 416
# observed), not user free text to scan. Whitelisted entirely, same
# "wl:0" pattern as WordPress's "content" / Wiki.js's "query" fields.
BasicRule wl:0 "mz:$ARGS_VAR:names";
BasicRule wl:0 "mz:$ARGS_VAR:context";
BasicRule wl:0 "mz:$BODY_VAR:context";
BasicRule wl:0 "mz:$BODY_VAR:content";
BasicRule wl:0 "mz:$BODY_VAR:text";
BasicRule wl:0 "mz:$BODY_VAR:general_settings";
BasicRule wl:0 "mz:$BODY_VAR:url";
