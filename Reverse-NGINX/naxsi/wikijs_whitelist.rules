# Wiki.js naxsi whitelist - hand-written, NOT a community-maintained
# ruleset (none exists for Wiki.js). Scoped narrowly to fix confirmed
# false positives from real traffic in naxsi_error.log; only extend
# when a new false positive is confirmed there, not speculatively.

# /graphql's "query" field is a GraphQL query document - parentheses
# and braces are core GraphQL syntax (e.g. "query { pages(id: 1) {
# content } }"), so almost any real query trips the SQL/XSS
# parenthesis rule (1010). This is structured API payload, not
# user-facing free text - same "wl:0" pattern used for WordPress's
# free-form "content" field and Passbolt's gpg_auth fields.
BasicRule wl:0 "mz:$URL:/graphql|$BODY_VAR:query";

# GraphQL "variables" payload's "content" field is the page's actual
# Markdown/HTML content being saved - free-form rich text full of
# quotes, same false positive WordPress's "content" field has. Same
# "wl:0" treatment, scoped to this endpoint.
BasicRule wl:0 "mz:$URL:/graphql|$BODY_VAR:content";

# Page "title" field - free-form text, e.g. an apostrophe ("L'article")
# trips the SQL/XSS single-quote rule (1013). Same wl:0 treatment.
BasicRule wl:0 "mz:$URL:/graphql|$BODY_VAR:title";
